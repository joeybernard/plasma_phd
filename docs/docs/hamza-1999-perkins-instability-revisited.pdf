            <rdf:Alt>
               <rdf:li xml:lang="x-default">Ionosphere: Ionosphere/atmosphere interactions; Ionosphere: Plasma waves and instabilities; Ionosphere: Midlatitude ionosphere; Ionosphere: Ionospheric irregularities; Interplanetary Physics: Ejecta, driver gases, and magnetic clouds; Interplanetary Physics: Interplanetary magnetic fields; Space Plasma Physics: Numerical simulation studies</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Perkins instability revisited</rdf:li>
            </rdf:Alt>
         </dc:title>
